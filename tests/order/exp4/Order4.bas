Private Sub T_Stmt_N()
    Dim x As Long, d As Double, c As Currency, s As String, a(1 To 50) As Long, i As Integer
    a(LA(1)) = LA(2)
    Done "N a(LA(1)) = LA(2)"
    a(LA(1)) = LA(2) + LA(3)
    Done "N a(LA(1)) = LA(2) + LA(3)"
    a(LZ1) = LZ2
    Done "N a(LZ1) = LZ2"
    a(LZ1) = LZ2 + LZ3
    Done "N a(LZ1) = LZ2 + LZ3"
    a(LA(1)) = DA(2)
    Done "N a(LA(1)) = DA(2)"
    a(LA(1)) = a(LA(2)) + LA(3)
    Done "N a(LA(1)) = a(LA(2)) + LA(3)"
    x = LA(1) + LA(2)
    Done "N Long target"
    d = LA(1) + LA(2)
    Done "N Double target: Long +"
    c = CA(1) + CA(2)
    Done "N Currency target"
    i = IA(1) + IA(2)
    Done "N Integer target"
    If LA(1) = LA(2) Then x = 0
    Done "N If LA(1) = LA(2)"
    If LA(1) + LA(2) > LA(3) Then x = 0
    Done "N If a + b > c"
    For x = LA(1) To LA(2) Step LA(3): Next
    Done "N For a To b Step c"
    For x = LZ1 To LZ2 Step LZ3: Next
    Done "N For Z"
    Select Case LA(1): Case LA(2), LA(3): End Select
