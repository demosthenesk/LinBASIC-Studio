Private Sub T_Other()
    Dim i As Integer, l As Long, d As Double, s As String, b As Boolean, v As Variant
    Dim o As Collection, x As Long
    On Error Resume Next
    i = I1 + I2
    Done "target Integer: a + b"
    l = I1 + I2
    Done "target Long: Integer a + b"
    d = I1 + I2
    Done "target Double: Integer a + b"
    d = D1 + D2
    Done "target Double: Double a + b"
    i = D1 + D2
    Done "target Integer: Double a + b"
    s = S1 & S2
    Done "target String: a & b"
    b = I1 < I2
    Done "target Boolean: a < b"
    Arr(N(1)) = N(2)
    Done "Arr(a) = b"
    Arr(N(1)) = N(2) + N(3)
    Done "Arr(a) = b + c"
    Arr(N(1) + N(2)) = N(3)
    Done "Arr(a + b) = c"
    Arr2(N(1), N(2)) = N(3)
    Done "Arr2(a, b) = c"
    Arr(N(1)) = Arr(N(2)) + N(3)
    Done "Arr(a) = Arr(b) + c"
    x = Arr(N(1)) + Arr(N(2))
    Done "Arr(a) + Arr(b)"
    Arr(N(1)) = Arr(N(2))
    Done "Arr(a) = Arr(b)"
    Set o = New Collection: o.Add N(1), CStr(N(2)): o.Add N(3)
    Done "o.Add a, CStr(b)"
    x = o(N(1)) + N(2)
    Done "o(a) + b"
    x = N(1) + o.Count
    Done "a + o.Count"
    Mid$(s, N(1), N(2)) = CStr(N(3))
    Done "Mid$(s, a, b) = c"
    s = String$(5, "x"): Mid$(s, N(1), N(2)) = CStr(N(3))
    Done "Mid$ stmt 2"
    If N(1) = N(2) Then x = 0
    Done "If a = b"
    If N(1) + N(2) > N(3) Then x = 0
    Done "If a + b > c"
    Do While N(1) > N(2): Loop
    Done "Do While a > b"
    For x = N(1) To N(2) Step N(3): Next
    Done "For x = a To b Step c"
    Select Case N(1): Case N(2), N(3): End Select
    Done "Select Case a / Case b, c"
    v = IIf(N(1) > 0, N(2), N(3))
    Done "IIf(a, b, c)"
    v = Choose(N(1), N(2), N(3))
    Done "Choose(a, b, c)"
    v = Switch(N(1) = 1, N(2), N(3) = 3, N(4))
    Done "Switch"
    x = N(1) + N(2): x = N(3)
    Done "two statements"
    x = N(1) Mod N(2) + N(3) \ N(4)
    Done "a Mod b + c \ d"
    d = N(1) / N(2) + N(3)
    Done "Long a / b + c"
    d = N(1) ^ N(2) + N(3)
    Done "Long a ^ b + c"
    v = N(1) & N(2) + N(3)
    Done "a & b + c"
    v = N(1) + N(2) & N(3)
    Done "a + b & c"
    b = N(1) = N(2) Or N(3) = N(4)
    Done "a = b Or c = d"
    b = Not N(1) = N(2)
    Done "Not a = b"
    x = -N(1) - -N(2)
    Done "-a - -b"
    x = N(1) - N(2) - N(3)
    Done "a - b - c"
    d = N(1) / N(2) / N(3)
    Done "a / b / c"
    d = N(1) ^ N(2) ^ N(3)
    Done "a ^ b ^ c"
End Sub
Private Function InIDE() As Boolean
    On Error Resume Next
    Debug.Print 1 / 0
    InIDE = Err.Number <> 0
    Err.Clear
End Function
Sub Main()
    mF = FreeFile
    Open App.Path & "\" & App.EXEName & IIf(InIDE(), "-IDE", "") & ".txt" For Output As #mF
    T_Integer
    T_Long
    T_Byte
    T_Boolean
    T_Single
    T_Double
    T_Currency
    T_Date
    T_Variant
    T_String
    T_Mixed
    T_Other
    Close #mF
    MsgBox "Done: " & App.EXEName & IIf(InIDE(), "-IDE", "") & ".txt"
End Sub
