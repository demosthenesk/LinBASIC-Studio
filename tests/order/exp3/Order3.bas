    r = o.FM(1) + 7 + o.FM(2)
    Done "Single M a + k + b"
    r = 7 + o.FM(1) + o.FM(2)
    Done "Single M k + a + b"
    r = o.FM(1) + v
    Done "Single M a + v"
    r = v + o.FM(1)
    Done "Single M v + a"
    r = -o.FM(1) + o.FM(2)
    Done "Single M -a + b"
    r = o.FM(1) + -o.FM(2)
    Done "Single M a + -b"
    r = o.FM(1) + o.FM(2) + o.FM(3) + o.FM(4)
    Done "Single M a + b + c + d"
    r = G2(o.FM(1), o.FM(2)) + o.FM(3)
    Done "Single M G2(a, b) + c"
    r = o.FM(1) + G2(o.FM(2), o.FM(3))
    Done "Single M a + G2(b, c)"
    r = G2(o.FM(1), o.FM(2) + o.FM(3))
    Done "Single M G2(a, b + c)"
    r = G2(o.FM(1) + o.FM(2), o.FM(3))
    Done "Single M G2(a + b, c)"
    r = o.FM(1) = o.FM(2) + o.FM(3)
    Done "Single M a = b + c"
    r = o.FM(1) + o.FM(2) = o.FM(3)
    Done "Single M a + b = c"
    r = o.FM(1) < o.FM(2) And o.FM(3) < o.FM(4)
    Done "Single M a < b And c < d"
    r = CDbl(o.FM(1)) + o.FM(2)
    Done "Single M CDbl(a) + b"
    r = o.FM(1) + CLng(o.FM(2))
    Done "Single M a + CLng(b)"
    r = CInt(o.FM(1)) + CLng(o.FM(2))
    Done "Single M CInt(a) + CLng(b)"
    r = o.FM(1) + o.FM(2) / o.FM(3)
    Done "Single M a + b / c"
End Sub
Private Sub T_Stmt()
    Dim x As Long, d As Double, c As Currency, s As String, a(1 To 50) As Long, i As Integer
    On Error Resume Next
    a(LA(1)) = LA(2)
    Done "a(LA(1)) = LA(2)"
    a(LA(1)) = LA(2) + LA(3)
    Done "a(LA(1)) = LA(2) + LA(3)"
    a(LZ1) = LZ2
    Done "a(LZ1) = LZ2"
    a(LZ1) = LZ2 + LZ3
    Done "a(LZ1) = LZ2 + LZ3"
    a(LA(1)) = DA(2)
    Done "a(LA(1)) = DA(2)"
    a(LA(1)) = a(LA(2)) + LA(3)
    Done "a(LA(1)) = a(LA(2)) + LA(3)"
    x = LA(1) + LA(2)
    Done "Long target"
    d = LA(1) + LA(2)
    Done "Double target: Long +"
    c = CA(1) + CA(2)
    Done "Currency target"
    i = IA(1) + IA(2)
    Done "Integer target"
    If LA(1) = LA(2) Then x = 0
    Done "If LA(1) = LA(2)"
    If LA(1) + LA(2) > LA(3) Then x = 0
    Done "If a + b > c"
    For x = LA(1) To LA(2) Step LA(3): Next
    Done "For a To b Step c"
    For x = LZ1 To LZ2 Step LZ3: Next
    Done "For Z"
    Select Case LA(1): Case LA(2), LA(3): End Select
    Done "Select Case"
    x = IIf(LA(1) > 0, LA(2), LA(3))
    Done "IIf"
    x = Choose(LA(1), LA(2), LA(3))
    Done "Choose"
    Mid$(s, LA(1), LA(2)) = SA(3)
    Done "Mid$ stmt"
    s = Mid$(SA(1), LA(2), LA(3))
    Done "Mid$ function"
    x = InStr(LA(1), SA(2), SA(3))
    Done "InStr"
    s = Left$(SA(1), LA(2)) & SA(3)
    Done "Left$ & c"
    x = LA(1) + Len(SA(2))
    Done "a + Len(b)"
    d = Sqr(DA(1)) + DA(2)
    Done "Sqr(a) + b"
    o.LM LA(1) + LA(2)
    Done "method call statement"
    x = o.LM(LA(1)) + LA(2)
    Done "method(a) + b"
    Print #mF, LA(1); LA(2); LA(3)
    Done "Print # items"
End Sub
Private Function InIDE() As Boolean
    On Error Resume Next
    Debug.Print 1 / 0
    InIDE = Err.Number <> 0
    Err.Clear
End Function
