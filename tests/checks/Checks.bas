    Rep "H int 1 / int 0", d, Err.Number
    Err.Clear
    i = 0: i = KI(1) \ KI(0)
    Rep "H int 1 \ int 0", i, Err.Number
    Err.Clear
    i = 0: i = KI(1) Mod KI(0)
    Rep "H int 1 Mod int 0", i, Err.Number
    Err.Clear
    v = Empty: v = CVar(KD(1)) / CVar(KD(0))
    Rep "H Variant 1 / 0", v, Err.Number
    Err.Clear
    i = 0: i = KD(1E+300) * KD(1E+300)
    Rep "H 1e300*1e300 to Integer", i, Err.Number
    Err.Clear
    bo = False: z = KD(0): bo = (z / z) = (z / z)
    Rep "H 0/0 = 0/0", bo, Err.Number
    Err.Clear
    d = 0: d = Sqr(KD(-1))
    Rep "H Sqr(-1)", d, Err.Number
    Err.Clear
    d = 0: d = Log(KD(0))
    Rep "H Log(0)", d, Err.Number
End Sub
Private Function N_Unround0() As Variant
    Dim i As Integer, l As Long, b As Byte, c As Currency, d As Double, s As Single, z As Double
    Dim v As Variant, n As Long, x As Long, bo As Boolean, d1 As Double, d2 As Double, s1 As Single, s2 As Single
    Dim dd() As Long, mm() As Long, bb(0 To 3) As Byte
    d1 = KD(1E+16): d2 = KD(1): d = (d1 + d2) - d1
    N_Unround0 = d
End Function
Private Function N_Unround1() As Variant
    Dim i As Integer, l As Long, b As Byte, c As Currency, d As Double, s As Single, z As Double
    Dim v As Variant, n As Long, x As Long, bo As Boolean, d1 As Double, d2 As Double, s1 As Single, s2 As Single
    Dim dd() As Long, mm() As Long, bb(0 To 3) As Byte
    d1 = KD(1E+16): d2 = KD(1): bo = (d1 + d2) > d1
    N_Unround1 = bo
End Function
Private Function N_Unround2() As Variant
    Dim i As Integer, l As Long, b As Byte, c As Currency, d As Double, s As Single, z As Double
    Dim v As Variant, n As Long, x As Long, bo As Boolean, d1 As Double, d2 As Double, s1 As Single, s2 As Single
    Dim dd() As Long, mm() As Long, bb(0 To 3) As Byte
    s1 = KS(16777216): s2 = KS(1): s = (s1 + s2) - s1
    N_Unround2 = s
End Function
Private Function N_Unround3() As Variant
    Dim i As Integer, l As Long, b As Byte, c As Currency, d As Double, s As Single, z As Double
    Dim v As Variant, n As Long, x As Long, bo As Boolean, d1 As Double, d2 As Double, s1 As Single, s2 As Single
    Dim dd() As Long, mm() As Long, bb(0 To 3) As Byte
    s1 = KS(16777216): s2 = KS(1): bo = (s1 + s2) > s1
    N_Unround3 = bo
End Function
Private Function N_Unround4() As Variant
    Dim i As Integer, l As Long, b As Byte, c As Currency, d As Double, s As Single, z As Double
    Dim v As Variant, n As Long, x As Long, bo As Boolean, d1 As Double, d2 As Double, s1 As Single, s2 As Single
    Dim dd() As Long, mm() As Long, bb(0 To 3) As Byte
    bo = (KS(0.1) * KS(3) = 0.3!)
    N_Unround4 = bo
End Function
Private Function N_Unround5() As Variant
    Dim i As Integer, l As Long, b As Byte, c As Currency, d As Double, s As Single, z As Double
    Dim v As Variant, n As Long, x As Long, bo As Boolean, d1 As Double, d2 As Double, s1 As Single, s2 As Single
    Dim dd() As Long, mm() As Long, bb(0 To 3) As Byte
    bo = (KD(0.1) + KD(0.2) = 0.3)
    N_Unround5 = bo
End Function
Private Function N_Unround6() As Variant
    Dim i As Integer, l As Long, b As Byte, c As Currency, d As Double, s As Single, z As Double
    Dim v As Variant, n As Long, x As Long, bo As Boolean, d1 As Double, d2 As Double, s1 As Single, s2 As Single
    Dim dd() As Long, mm() As Long, bb(0 To 3) As Byte
    s = KS(1) / KS(3): bo = (s = KS(1) / KS(3))
    N_Unround6 = bo
End Function
Private Function N_Unround7() As Variant
    Dim i As Integer, l As Long, b As Byte, c As Currency, d As Double, s As Single, z As Double
    Dim v As Variant, n As Long, x As Long, bo As Boolean, d1 As Double, d2 As Double, s1 As Single, s2 As Single
    Dim dd() As Long, mm() As Long, bb(0 To 3) As Byte
    d = KD(1) / KD(3): bo = (d = KD(1) / KD(3))
    N_Unround7 = bo
End Function
Private Function N_Unround8() As Variant
    Dim i As Integer, l As Long, b As Byte, c As Currency, d As Double, s As Single, z As Double
    Dim v As Variant, n As Long, x As Long, bo As Boolean, d1 As Double, d2 As Double, s1 As Single, s2 As Single
    Dim dd() As Long, mm() As Long, bb(0 To 3) As Byte
    bo = (CSng(KD(1) / KD(3)) = KS(1) / KS(3))
    N_Unround8 = bo
End Function
Private Function N_Unround9() As Variant
    Dim i As Integer, l As Long, b As Byte, c As Currency, d As Double, s As Single, z As Double
    Dim v As Variant, n As Long, x As Long, bo As Boolean, d1 As Double, d2 As Double, s1 As Single, s2 As Single
    Dim dd() As Long, mm() As Long, bb(0 To 3) As Byte
    s = KS(1) / KS(3) * KS(3)
    N_Unround9 = s
End Function
Private Function N_Unround10() As Variant
    Dim i As Integer, l As Long, b As Byte, c As Currency, d As Double, s As Single, z As Double
    Dim v As Variant, n As Long, x As Long, bo As Boolean, d1 As Double, d2 As Double, s1 As Single, s2 As Single
    Dim dd() As Long, mm() As Long, bb(0 To 3) As Byte
    s = 0: For n = 1 To 10: s = s + KS(0.1): Next
    N_Unround10 = s
End Function
Private Function N_Unround11() As Variant
    Dim i As Integer, l As Long, b As Byte, c As Currency, d As Double, s As Single, z As Double
    Dim v As Variant, n As Long, x As Long, bo As Boolean, d1 As Double, d2 As Double, s1 As Single, s2 As Single
    Dim dd() As Long, mm() As Long, bb(0 To 3) As Byte
    d = CDbl(KS(1) / KS(3) * KS(3)) - 1
    N_Unround11 = d
End Function
Private Sub T_Unround_N()
    Dim rv As Variant
    On Error Resume Next
    Err.Clear: rv = "(none)"
    rv = N_Unround0()
    Rep "N (1e16 + 1) - 1e16", rv, Err.Number
    Err.Clear: rv = "(none)"
    rv = N_Unround1()
    Rep "N (1e16 + 1) > 1e16", rv, Err.Number
    Err.Clear: rv = "(none)"
    rv = N_Unround2()
    Rep "N single (2^24 + 1) - 2^24", rv, Err.Number
    Err.Clear: rv = "(none)"
    rv = N_Unround3()
    Rep "N single (2^24 + 1) > 2^24", rv, Err.Number
    Err.Clear: rv = "(none)"
    rv = N_Unround4()
    Rep "N single 0.1 * 3 = 0.3!", rv, Err.Number
    Err.Clear: rv = "(none)"
    rv = N_Unround5()
    Rep "N 0.1 + 0.2 = 0.3", rv, Err.Number
    Err.Clear: rv = "(none)"
    rv = N_Unround6()
    Rep "N single s = 1/3 then s = 1/3", rv, Err.Number
    Err.Clear: rv = "(none)"
    rv = N_Unround7()
    Rep "N double d = 1/3 then d = 1/3", rv, Err.Number
    Err.Clear: rv = "(none)"
    rv = N_Unround8()
    Rep "N CSng(1/3) = single 1/3", rv, Err.Number
    Err.Clear: rv = "(none)"
    rv = N_Unround9()
    Rep "N single 1/3*3", rv, Err.Number
    Err.Clear: rv = "(none)"
    rv = N_Unround10()
    Rep "N single sum 0.1 x10", rv, Err.Number
    Err.Clear: rv = "(none)"
    rv = N_Unround11()
    Rep "N single (1/3)*3 - 1 in double", rv, Err.Number
End Sub
Private Sub T_Unround_H()
    Dim i As Integer, l As Long, b As Byte, c As Currency, d As Double, s As Single, z As Double
    Dim v As Variant, n As Long, x As Long, bo As Boolean, d1 As Double, d2 As Double, s1 As Single, s2 As Single
    Dim dd() As Long, mm() As Long, bb(0 To 3) As Byte
    On Error Resume Next
    Err.Clear
    d1 = KD(1E+16): d2 = KD(1): d = (d1 + d2) - d1
    Rep "H (1e16 + 1) - 1e16", d, Err.Number
    Err.Clear
    d1 = KD(1E+16): d2 = KD(1): bo = (d1 + d2) > d1
    Rep "H (1e16 + 1) > 1e16", bo, Err.Number
    Err.Clear
    s1 = KS(16777216): s2 = KS(1): s = (s1 + s2) - s1
    Rep "H single (2^24 + 1) - 2^24", s, Err.Number
    Err.Clear
    s1 = KS(16777216): s2 = KS(1): bo = (s1 + s2) > s1
    Rep "H single (2^24 + 1) > 2^24", bo, Err.Number
    Err.Clear
    bo = (KS(0.1) * KS(3) = 0.3!)
    Rep "H single 0.1 * 3 = 0.3!", bo, Err.Number
    Err.Clear
    bo = (KD(0.1) + KD(0.2) = 0.3)
    Rep "H 0.1 + 0.2 = 0.3", bo, Err.Number
    Err.Clear
    s = KS(1) / KS(3): bo = (s = KS(1) / KS(3))
    Rep "H single s = 1/3 then s = 1/3", bo, Err.Number
    Err.Clear
    d = KD(1) / KD(3): bo = (d = KD(1) / KD(3))
    Rep "H double d = 1/3 then d = 1/3", bo, Err.Number
    Err.Clear
    bo = (CSng(KD(1) / KD(3)) = KS(1) / KS(3))
    Rep "H CSng(1/3) = single 1/3", bo, Err.Number
    Err.Clear
    s = KS(1) / KS(3) * KS(3)
    Rep "H single 1/3*3", s, Err.Number
    Err.Clear
    s = 0: For n = 1 To 10: s = s + KS(0.1): Next
    Rep "H single sum 0.1 x10", s, Err.Number
    Err.Clear
    d = CDbl(KS(1) / KS(3) * KS(3)) - 1
    Rep "H single (1/3)*3 - 1 in double", d, Err.Number
End Sub
Private Sub T_Undim()
    Dim ee() As Long, x As Long
    On Error Resume Next
    Err.Clear: x = -1
    x = ee(KL(1))
    Rep "H undimensioned ee(1)", x, Err.Number
End Sub
Sub Main()
    FillAll
    mF = FreeFile
    Open App.Path & "\" & App.EXEName & ".txt" For Output As #mF
    T_Int_N
    T_Int_H
    T_Bounds_N
    T_Bounds_H
    T_Float_N
    T_Float_H
    T_Unround_N
    T_Unround_H
    Close #mF
    ' (the last one may crash the program: the file is closed before it)
    mF = FreeFile
    Open App.Path & "\" & App.EXEName & ".txt" For Append As #mF
    T_Undim
    Close #mF
    MsgBox "Done: " & App.EXEName & ".txt"
End Sub
